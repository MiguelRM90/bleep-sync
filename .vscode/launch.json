{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm ng serve --open"
    },
    {
      "name": "ng serve & Debug (Browser)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "ng serve",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
